# Use the official MATLAB Runtime base image for R2024b
FROM containers.mathworks.com/matlab-runtime:r2024b
LABEL maintainer="hss70@bath.ac.uk"
LABEL description="Container for testing Simulink compiled code (LOCAL TEST VERSION)."

# Install required utilities
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        jq \
        libgl1 \
        libglu1-mesa \
        libxext6 \
        libxmu6 \
        libxt6 \
        unzip && \
    rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Accept MATLAB Runtime license
ENV AGREE_TO_MATLAB_RUNTIME_LICENSE=yes

# Copy the compiled MATLAB application
COPY output_dir/validate_compiled_output ./validate_compiled_output
COPY output_dir/run_validate_compiled_output.sh ./run_validate_compiled_output.sh
COPY reference_output.mat ./reference_output.mat
COPY sim_bandpass_singleBand.slxc ./sim_bandpass_singleBand.slxc

# Copy the test execution script
COPY test_simulink_local.sh ./test_simulink_local.sh

# Make all scripts and the application executable
RUN chmod +x ./test_simulink_local.sh ./validate_compiled_output ./run_validate_compiled_output.sh

# Set the entrypoint to the test script
ENTRYPOINT ["./test_simulink_local.sh"]