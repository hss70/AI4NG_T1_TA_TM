# Use the official MATLAB Runtime base image for R2024b
FROM containers.mathworks.com/matlab-runtime:r2024b

LABEL maintainer="hss70@bath.ac.uk"
LABEL description="Container for running FBCSP MATLAB classification training (LOCAL TEST VERSION)."

# Install required utilities
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        jq \
        libgl1 \
        libglu1-mesa \
        libxext6 \
        libxmu6 \
        libxt6 \
        python3-pip \
        unzip && \
    rm -rf /var/lib/apt/lists/* && \
    pip3 install --no-cache-dir awscli --break-system-packages

# Set the working directory
WORKDIR /app

# MATLAB Runtime container requirements / runtime safety
ENV AGREE_TO_MATLAB_RUNTIME_LICENSE=yes
ENV MCR_CACHE_ROOT=/tmp/mcr-cache
ENV MATLAB_PREFDIR=/tmp/matlab-prefs

# Copy required data files
COPY MIClassifierTraining/Standard-10-20-Cap81.locs ./Standard-10-20-Cap81.locs

# Copy the compiled MATLAB application
COPY MIClassifierTraining/output/FBCSP_Training ./FBCSP_Training
COPY MIClassifierTraining/output/run_FBCSP_Training.sh ./run_FBCSP_Training.sh

# Copy the local test execution script
COPY download_and_run_local.sh ./download_and_run.sh

# Make all scripts and the application executable
RUN chmod +x ./download_and_run.sh && \
    if [ -f "./FBCSP_Training" ]; then chmod +x ./FBCSP_Training ./run_FBCSP_Training.sh; fi

# Set the entrypoint to the main execution script
ENTRYPOINT ["./download_and_run.sh"]